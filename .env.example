PORT=8000
SERVER_URL=https://api.your-domain.com
LINK=mongodb://localhost:27017/your-db-name
jwtSecretKey=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:3000

# Google OAuth
googleClientId=your-google-client-id
googleClientSecret=your-google-client-secret

# Cloudinary
cloudname=your-cloud-name
cloudApiKey=your-cloud-api-key
cloudApiSecret=your-cloud-api-secret

# Email / SMTP (BREVO_API_KEY is used instead of SMTP when set)
email=your-email@example.com
password=your-email-password
BREVO_API_KEY=
# help messages from the app go here (defaults to email above)
SUPPORT_EMAIL=

# Paystack (secret key stays here, NEVER in the app)
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
# optional, defaults to <this server>/payments/callback
PAYSTACK_CALLBACK_URL=
